{
  "name": "omnisect",
  "version": "1.0.0",
  "private": true,
  "description": "Omnisect — recon scanner (web, desktop, mobile clients)",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:desktop": "npm --prefix apps/desktop run tauri:dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:desktop": "npm --prefix apps/desktop run tauri:build",
    "mobile:sync": "npm --prefix apps/mobile run sync",
    "mobile:open:android": "npm --prefix apps/mobile run open:android",
    "mobile:add:android": "npm --prefix apps/mobile run add:android",
    "test:backend": "npm --prefix backend test"
  }
}
